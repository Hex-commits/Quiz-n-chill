# Copy to `.env` and fill in the keys printed by `npm run db:start`.
# `.env` is gitignored; this file is the committed template.

# --- Supabase --------------------------------------------------------------
# From inside the api container the Supabase stack is on the host, not on the
# compose network, so this is host.docker.internal rather than 127.0.0.1.
# Running uvicorn directly on the host instead? Use http://127.0.0.1:54321.
SUPABASE_URL=http://host.docker.internal:54321

# `supabase start` prints this as "service_role key". It bypasses row level
# security, so it belongs only in the Python backend -- never in the frontend
# and never in a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- API -------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Origins allowed by pattern, for hosts whose URL is generated per deployment.
# Vercel names every preview differently, so without this only production can
# call the API and previews fail CORS -- silently, in the browser.
#
# Anchor it and include your own project prefix. A bare `.*\.vercel\.app` would
# let anyone's Vercel project call this API with credentials.
#   CORS_ORIGIN_REGEX=^https://quiz-n-chill-web-[a-z0-9-]+\.vercel\.app$
CORS_ORIGIN_REGEX=

# Shared secret for /admin routes, sent as the X-Admin-Token header.
# Optional in development; required in every other environment.
ADMIN_TOKEN=

# Host port the API is published on. Change it if something else owns 8001.
API_PORT=8001

# --- Frontend --------------------------------------------------------------
# Used by the browser, so it must be a URL the browser can reach.
# NEXT_PUBLIC_* values are inlined into the client bundle at build time --
# only put non-secret values here.
NEXT_PUBLIC_API_URL=http://localhost:8001

# Supabase Realtime, used only to hear that a lobby changed. Without these the
# room falls back to polling and still works, just less promptly.
#
# The anon/publishable key is safe in the browser *because* every table has row
# level security on with no policies -- it reads nothing. Putting the
# service-role key here instead would hand the answer key to every player.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set on the API side to turn the push on. Off by default: the game works on
# the fallback poll alone, and the test suite must not make network calls.
REALTIME_BROADCAST=false

# Where lobbies live. false keeps them in the API process, which needs a single
# long-lived container. true keeps them in `public.lobbies`, shared across
# instances -- required on Vercel, where consecutive requests land on different
# ones. Not history either way: rows expire and are swept.
SHARED_LOBBIES=true

# Used by server components, which run inside the web container.
# Compose overrides this to http://api:8000; set it for host-only runs.
API_URL=http://localhost:8001

# --- Question generator (tools/ingest) -------------------------------------
# The model runs locally in this project's Ollama container. 11435 rather than
# the default 11434, so it does not clash with another project's Ollama.
OLLAMA_PORT=11435
OLLAMA_URL=http://localhost:11435
INGEST_MODEL=glm4:9b

# Unlike the API, this tool runs on the host, so SUPABASE_URL above names a
# hostname it cannot resolve. Left unset, it falls back to SUPABASE_URL with
# host.docker.internal swapped for 127.0.0.1 -- which is right for the default
# compose setup and wrong for anything else. Set it explicitly to fill a
# different database: a second local stack, a tunnel, or a hosted project.
#   INGEST_SUPABASE_URL=https://<ref>.supabase.co
# Overridable per run with --supabase-url.
INGEST_SUPABASE_URL=http://127.0.0.1:54321

# The key for whichever project INGEST_SUPABASE_URL names. Unset, the tool uses
# SUPABASE_SERVICE_ROLE_KEY above -- which belongs to the *local* stack, so a
# run aimed at a hosted project would carry the wrong credential. Set both or
# neither: the URL and the key have to describe the same project.
#   INGEST_SUPABASE_SERVICE_ROLE_KEY=<service_role key from the hosted project>
# Overridable per run with --supabase-key.
#
# Careful: setting these two to a hosted project makes it the *default* target,
# so a bare `python -m tools.ingest --commit` writes to production. The run
# header prints [REMOTE PROJECT] when that is the case -- read it. Leaving them
# local and passing --supabase-url/--supabase-key per run is the safer habit.

# --- Supabase CLI (hosted project) -----------------------------------------
# NOTE: the Supabase CLI does not read this file. Only docker-compose and
# tools/ingest do. The CLI reads the real environment, so these are recorded
# here as documentation -- export them in your shell to actually use them.
#
# The project ref is not a secret (it is the subdomain of your API URL) and
# `supabase link` remembers it in supabase/.temp/, so it needs no entry at all.
#
# These two are secrets, and only needed to deploy migrations without being
# prompted. The access token comes from Account -> Access Tokens; the database
# password is the one set when the project was created -- not the service-role
# key.
#   SUPABASE_ACCESS_TOKEN=
#   SUPABASE_DB_PASSWORD=
